VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI diagnosis provider (services/ai/). Leave VITE_AI_API_KEY empty/unset
# to run entirely on the deterministic mock provider — the app is fully
# functional without any of these set. Only needed to use a real LLM.
VITE_AI_API_KEY=
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
VITE_AI_MODEL=gpt-4o-mini
